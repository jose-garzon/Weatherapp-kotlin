<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/sunny_background"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:alpha="0.2" />

    <ScrollView
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">
            <!-- City: is a heading for TalkBack -->
            <TextView
                android:id="@+id/city_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:accessibilityHeading="true"
                android:drawablePadding="8dp"
                android:fontFamily="@font/montserrat_black"
                android:text="@string/mock_city"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:textColor="?attr/colorOnSurface"
                app:drawableStartCompat="@drawable/icon_map_pin" />

            <TextView
                android:id="@+id/updatedAt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/montserrat_medium"
                android:text="@string/mock_updated_at"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                >
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    tools:ignore="UseCompoundDrawables">
                    <ImageView
                        android:id="@+id/ivCondition"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:contentDescription="@string/mock_weather_condition"
                        android:src="@drawable/icon_sunny"
                        app:tint="@color/sun_yellow" />

                    <TextView
                        android:id="@+id/tvCondition"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/montserrat_medium"
                        android:text="@string/mock_weather_condition"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>
                <!-- Temperature: liveRegion tells when the scale changes -->
                <TextView
                    android:id="@+id/temperature"
                    android:layout_width="0dp"
                    android:layout_height="65dp"
                    android:layout_gravity="bottom"
                    android:layout_weight="1"
                    android:accessibilityLiveRegion="polite"
                    android:fontFamily="@font/montserrat_black"
                    android:gravity="end"
                    android:text="@string/mock_temperature"
                    android:textAppearance="?attr/textAppearanceDisplayLarge"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>
        </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/hourly_background"
            android:padding="24dp"
            android:elevation="2dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:accessibilityHeading="true"
                android:fontFamily="@font/montserrat_bold"
                android:text="@string/hourly_title"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:baselineAligned="false">
                <include android:id="@+id/hour1" layout="@layout/hourly_report"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" />
                <include android:id="@+id/hour2" layout="@layout/hourly_report"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" />
                <include android:id="@+id/hour3" layout="@layout/hourly_report"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" />
                <include android:id="@+id/hour4" layout="@layout/hourly_report"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>
            <!-- Select °C / °F: both visible options, buttons 48dp height -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleScale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:contentDescription="@string/scale_label"
                app:checkedButton="@id/btnCelsius"
                app:selectionRequired="true"
                app:singleSelection="true">

                <Button
                    android:id="@+id/btnCelsius"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/celsius_description"
                    android:fontFamily="@font/montserrat_medium"
                    android:minWidth="88dp"
                    android:minHeight="48dp"
                    android:text="@string/celsius_symbol" />

                <Button
                    android:id="@+id/btnFahrenheit"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/fahrenheit_description"
                    android:fontFamily="@font/montserrat_medium"
                    android:minWidth="88dp"
                    android:minHeight="48dp"
                    android:text="@string/fahrenheit_symbol" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>
        </LinearLayout>
</ScrollView>
    </FrameLayout>